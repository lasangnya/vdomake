{
  "$schema": "https://turborepo.com/schema.json",
  "globalPassThroughEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "REDIS_URL",
    "ENCRYPTION_SECRET",
    "NEXT_PUBLIC_APP_URL",
    "LOG_LEVEL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "inputs": ["src/**", ".oxlintrc.json", "../../.oxlintrc.json"]
    },
    "format:check": {
      "inputs": ["src/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": ["src/**", "tsconfig.json", "tsconfig.*.json"]
    },
    "test": {
      "cache": false
    },
    "test:e2e": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "check": {
      "cache": false,
      "dependsOn": ["lint", "typecheck", "format:check", "test"]
    }
  }
}
