{
  "name": "vdomake",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "check": "turbo run check",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format:check": "turbo run format:check",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "db:push": "cd apps/web && bun run db:push",
    "db:studio": "cd apps/web && bun run db:studio",
    "db:generate": "cd apps/web && bun run db:generate",
    "worker": "bun run --cwd apps/web src/lib/queue/worker.ts"
  },
  "packageManager": "bun@1.3.13",
  "trustedDependencies": ["playwright", "esbuild", "sharp", "motion-canvas"],
  "catalog": {
    "bun-types": "^1.3.12",
    "drizzle-orm": "^0.45.2",
    "pino": "^10.3.1",
    "zod": "^4.4.3",
    "typescript": "^5"
  }
}
