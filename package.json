{
  "name": "vdomake",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "check": "turbo run check",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format:check": "turbo run format:check",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "db:push": "cd apps/web && bun run db:push",
    "db:studio": "cd apps/web && bun run db:studio",
    "db:generate": "cd apps/web && bun run db:generate",
    "worker": "bun run --cwd apps/web src/lib/queue/worker.ts",
    "format:fix": "turbo run format:fix",
    "knip": "knip",
    "vdo": "bun run --cwd apps/cli src/index.ts"
  },
  "packageManager": "bun@1.3.13",
  "trustedDependencies": [
    "playwright",
    "esbuild",
    "sharp",
    "motion-canvas"
  ],
  "catalog": {
    "bun-types": "^1.3.12",
    "drizzle-orm": "^0.45.2",
    "pino": "^10.3.1",
    "zod": "^4.4.3",
    "typescript": "^5",
    "@trpc/server": "^11.0.0",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@tanstack/react-query": "^5.96.1",
    "prettier": "^3.9.6",
    "citty": "^0.1.6",
    "execa": "^9.5.2",
    "yoctocolors": "^2.1.2",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "oxlint": "1.58.0",
    "oxfmt": "0.43.0",
    "ultracite": "7.4.2",
    "knip": "^6.0.0",
    "turbo": "^2.9.17"
  }
}
